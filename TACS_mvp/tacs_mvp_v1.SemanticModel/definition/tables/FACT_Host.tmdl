table FACT_Host
	lineageTag: c9cac734-e379-4c89-92fa-3e5beb90e06b

	measure 'TACS 등록률' =
			DIVIDE(
			    CALCULATE(COUNTROWS(FACT_TACS), FACT_TACS[TACS수용(OS)] = "Y"),
			    COUNTROWS(FACT_Host)
			)
		formatString: 0.0%
		lineageTag: b807a684-a63f-41e1-96ab-f2d041738ed5

	measure 정합성률 =
			DIVIDE(
			    CALCULATE(COUNTROWS(FACT_TACS_Matching), FACT_TACS_Matching[MatchStatus] = "MATCH"),
			    COUNTROWS(FACT_TACS_Matching)
			)
		formatString: 0.0%
		lineageTag: 6719f4d5-ab4e-43b6-a237-38cd50151668

	measure 'EDR 준수율' =
			DIVIDE(
			    CALCULATE(COUNTROWS(FACT_SecurityCompliance), FACT_SecurityCompliance[EDR설치] = "Y"),
			    COUNTROWS(FACT_SecurityCompliance)
			)
		formatString: 0.0%
		lineageTag: e1e573dd-4cef-439a-8d61-70189868ac79

	measure '총 호스트 수' = COUNTROWS(FACT_Host)
		formatString: #,0
		lineageTag: 33c22ead-72cd-4e35-9221-6b527d7ab127

	measure '총 장비 수' = COUNTROWS(FACT_Asset)
		formatString: #,0
		lineageTag: 4a440c59-e4e1-4561-858a-e643d2f3df3d

	measure 'TACS 대상 서버 수' = CALCULATE(COUNTROWS(FACT_Host), FACT_Host[TACS대상여부] = "Y")
		formatString: #,0
		lineageTag: 4f8ebd5b-0305-4560-889f-172a2865f254

	measure 'TACS 등록률(대상기준)' =
			DIVIDE(
			    CALCULATE(COUNTROWS(FACT_TACS), FACT_TACS[TACS수용(OS)] = "Y", FACT_Host[TACS대상여부] = "Y"),
			    CALCULATE(COUNTROWS(FACT_Host), FACT_Host[TACS대상여부] = "Y")
			)
		formatString: 0.0%
		lineageTag: b386d217-fd3b-4332-ba14-5f0ceacc25cc

